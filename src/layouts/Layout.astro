---
import '../styles/site.css';
import { getMenu } from 'emdash';
import { canonicalOrigin,jsonLd } from '../lib/catalog';
import { metaDescription } from '../lib/seo';
const {title='Software Reverse Engineering Research | Reverse Engineer Lab',description='Explore evidence-linked reverse engineering research: architecture, APIs, data models, and workflows, with explicit observations and limitations.',noindex=false,structured,article=false}=Astro.props;
const socialImage='https://reverseengineerlab.com/social-card.png';
const safeDescription=metaDescription(description);
const origin=canonicalOrigin();const canonical=origin?origin+Astro.url.pathname:null;
const menu=await getMenu('primary');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={safeDescription}/><meta name="robots" content={noindex||!origin?'noindex, follow':'index, follow'}/>{canonical&&<link rel="canonical" href={canonical}/>}<meta property="og:title" content={title}/><meta property="og:description" content={safeDescription}/><meta property="og:type" content={article?'article':'website'}/>{canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:site_name" content="Reverse Engineer Lab"/><meta property="og:image" content={socialImage}/><meta property="og:image:type" content="image/png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Reverse Engineer Lab — software research connecting systems, public evidence and understanding."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content={socialImage}/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={safeDescription}/><meta name="theme-color" content="#f3f0e8"/>{structured&&origin&&<script type="application/ld+json" set:html={jsonLd(structured)}/>}</head><body><a class="skip" href="#main">Skip to content</a><header><a class="brand" href="/" aria-label="Reverse Engineer Lab home"><span class="mark">r/e</span> REVERSE<span class="atlas">ENGINEER LAB</span></a><nav aria-label="Main navigation" data-content-source="emdash">{(menu?.items??[]).map((item:any)=><a href={item.url} class:list={['nav-link',{'nav-submit':item.url==='/submit'}]}>{item.label}{item.url==='/submit'&&<span aria-hidden="true"> ↗</span>}</a>)}</nav></header><main id="main"><slot/></main><footer><div><a class="brand small" href="/">REVERSE ENGINEER LAB</a><p>Know how it works. Know what you don't.</p></div><div><p>An independent research catalog.</p><p>Not affiliated with the Reverse Engineer Anything project.</p><a href="/_emdash/admin/plugins/rea-catalog/review">Editor sign in ↗</a></div></footer></body></html>
