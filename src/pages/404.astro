---
import Layout from "../layouts/Layout.astro";
Astro.response.status = 404;
---

<Layout title="Not found | Reverse Engineer Lab" noindex>
  <section class="notfound-card">
    <div class="eyebrow">
      <span class="pip pip-amber" aria-hidden="true"></span>
      <span>404 / NOT IN THE INDEX</span>
    </div>
    <h1>
      No research<br />
      at this address.
    </h1>
    <p class="lede" style="margin-bottom: 24px;">
      The entry may not be published, or the link may have changed.
    </p>
    <a class="btn-primary" href="/">
      <span>Browse the catalog</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </section>
</Layout>
