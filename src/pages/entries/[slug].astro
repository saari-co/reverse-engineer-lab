---
import Layout from '../../layouts/Layout.astro';
import { getEmDashEntry } from 'emdash';
import { evidenceLinks,canonicalOrigin } from '../../lib/catalog';
import { metaDescription, authorEntity } from '../../lib/seo';
import { researchPresentation } from '../../lib/research-presentation';
import { fieldLabels } from '../../lib/validation';
const {entry}=await getEmDashEntry('distillations',Astro.params.slug!);
if(!entry||entry.data.status!=='published')return Astro.rewrite('/404');
const d:any=entry.data;const links=evidenceLinks(d.links);const origin=canonicalOrigin();
const presentation=researchPresentation[entry.id];
const structured={'@context':'https://schema.org','@type':'Article',headline:d.title,description:d.summary,author:authorEntity(d.author),publisher:authorEntity('Reverse Engineer Lab'),image:{'@type':'ImageObject',url:origin+'/social-card.png',width:1200,height:630},dateCreated:d.investigated_at,datePublished:d.publishedAt,dateModified:d.updatedAt,mainEntityOfPage:origin+'/entries/'+entry.id,citation:links,about:{'@type':'Thing',name:d.target}};
---
<Layout title={`${presentation?.title??d.title} | Reverse Engineer Lab`} description={metaDescription(d.summary)} structured={structured} article><article class="detail" data-content-source="emdash"><a class="back" href="/">← All distillations</a><div class="eyebrow">{d.kind} / {d.target}</div><h1>{d.title}</h1><p class="lede">{d.summary}</p><div class="metadata"><span><b>INVESTIGATED BY</b>{d.author}</span><span><b>DATE</b>{d.investigated_at}</span><span><b>VERSION / REVISION</b>{d.target_version}</span></div>{presentation&&<figure class="model-sketch"><figcaption>Contract model · conceptual sequence, not a claim about internal deployment</figcaption><ol>{presentation.steps.map(step=><li>{step}</li>)}</ol></figure>}<div class="article-layout"><div>{Object.entries(fieldLabels).filter(([key])=>key!=='summary'&&d[key]).map(([key,label])=><section class:list={['article-section',{'coverage':key==='unknown'}]} id={key}><h2>{label}</h2><p>{d[key]}</p></section>)}</div><aside class="sources"><div class="eyebrow">FOLLOW THE EVIDENCE</div><h2>Sources & analysis</h2><p>Links are supplied by the author. Review their scope and revision; a link alone does not establish a claim.</p><ol>{links.map(link=><li><a href={link} rel="ugc nofollow noopener noreferrer" target="_blank">{new URL(link).hostname}<span>{new URL(link).pathname} ↗</span></a></li>)}</ol></aside></div>{presentation&&<section class="related-research"><h2>Related investigations</h2><ul>{presentation.related.filter(slug=>researchPresentation[slug]).map(slug=><li><a href={'/entries/'+slug}>{researchPresentation[slug].title}</a></li>)}</ul></section>}</article></Layout>
