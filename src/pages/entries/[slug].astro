---
import Layout from "../../layouts/Layout.astro";
import { getEmDashEntry } from "emdash";
import { evidenceLinks, canonicalOrigin } from "../../lib/catalog";
import { metaDescription, authorEntity } from "../../lib/seo";
import { researchPresentation } from "../../lib/research-presentation";
import { fieldLabels } from "../../lib/validation";

const { entry } = await getEmDashEntry("distillations", Astro.params.slug!);
if (!entry || entry.data.status !== "published") return Astro.rewrite("/404");

const d = entry.data as Record<string, string | undefined>;
const links = evidenceLinks(d.links);
const origin = canonicalOrigin();
const presentation = researchPresentation[entry.id];

const structured = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title ?? "",
  description: d.summary ?? "",
  author: authorEntity(d.author ?? "Reverse Engineer Lab"),
  publisher: authorEntity("Reverse Engineer Lab"),
  image: {
    "@type": "ImageObject",
    url: (origin ?? "https://reverseengineerlab.com") + "/social-card-c2.png",
    width: 1200,
    height: 630,
  },
  dateCreated: d.investigated_at,
  datePublished: d.publishedAt,
  dateModified: d.updatedAt,
  mainEntityOfPage: origin ? origin + "/entries/" + entry.id : undefined,
  citation: links,
  about: { "@type": "Thing", name: d.target ?? "" },
};

const renderedSections = Object.entries(fieldLabels).filter(
  ([key]) => key !== "summary" && Boolean(d[key]),
);
---

<Layout
  title={`${presentation?.title ?? d.title} | Reverse Engineer Lab`}
  description={metaDescription(d.summary ?? "")}
  structured={structured}
  article
>
  <article class="detail" data-content-source="emdash">
    <div class="breadcrumb-bar">
      <a class="back" href="/">← All distillations</a>
      <span class="tag">
        {d.kind} · {d.target}
      </span>
    </div>

    <header class="dossier-hero">
      <div class="corner-pin corner-pin-tl" aria-hidden="true"></div>
      <div class="corner-pin corner-pin-br" aria-hidden="true"></div>

      <div class="eyebrow">
        <span class="pip" aria-hidden="true"></span>
        <span>
          {d.kind} / {d.target}
        </span>
      </div>

      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>

      {
        presentation?.repo && (
          <div class="dossier-actions">
            <a
              class="btn-primary btn-repo"
              href={presentation.repo.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
              </svg>
              <span>View on GitHub: {presentation.repo.label}</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
            <span class="repo-meta-tag">Apache-2.0 · Open-source runtime</span>
          </div>
        )
      }

      <div class="metadata">
        <div class="metadata-cell">
          <b>INVESTIGATED BY</b>
          {d.author}
        </div>
        <div class="metadata-cell">
          <b>DATE</b>
          {d.investigated_at}
        </div>
        <div class="metadata-cell">
          <b>VERSION / REVISION</b>
          {d.target_version}
        </div>
      </div>
    </header>

    {
      presentation?.banner && (
        <figure class="specimen-banner">
          <div class="specimen-banner-media">
            <img
              class="theme-img-light"
              src={presentation.banner.light}
              alt={presentation.banner.alt}
              width="1600"
              height="900"
              loading="eager"
              decoding="async"
            />
            <img
              class="theme-img-dark"
              src={presentation.banner.dark}
              alt={presentation.banner.alt}
              width="1600"
              height="900"
              loading="eager"
              decoding="async"
            />
          </div>
          <figcaption>
            <span>{presentation.banner.caption}</span>
            {presentation.repo && (
              <a href={presentation.repo.url} target="_blank" rel="noopener noreferrer">
                {presentation.repo.label} ↗
              </a>
            )}
          </figcaption>
        </figure>
      )
    }

    {
      presentation && (
        <figure class="model-sketch">
          <figcaption>
            Contract model · conceptual sequence, not a claim about internal deployment
          </figcaption>
          <ol>
            {presentation.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </figure>
      )
    }

    {
      presentation?.diagram && (
        <figure class="specimen-diagram">
          <figcaption>{presentation.diagram.caption}</figcaption>
          <div class="specimen-diagram-frame">
            <img
              src={presentation.diagram.src}
              alt={presentation.diagram.alt}
              width="980"
              height="230"
              loading="lazy"
              decoding="async"
            />
          </div>
        </figure>
      )
    }

    <div class="article-layout">
      <div class="article-stack">
        {
          renderedSections.map(([key, label], idx) => {
            const isBoundary = key === "unknown";
            return (
              <section class:list={["article-section", { coverage: isBoundary }]} id={key}>
                <div class="article-section-kicker">
                  <span class:list={["pip", { "pip-amber": isBoundary }]} aria-hidden="true" />
                  <span>
                    {String(idx + 1).padStart(2, "0")} /{" "}
                    {isBoundary ? "METHODOLOGICAL BOUNDARY" : "EMPIRICAL RECORD"}
                  </span>
                </div>
                <h2>{label}</h2>
                <p>{d[key]}</p>
              </section>
            );
          })
        }
      </div>

      <aside class="detail-sidebar">
        {
          presentation?.repo && (
            <div class="repo-card">
              <div class="eyebrow">
                <span class="pip" aria-hidden="true"></span>
                <span>OPEN-SOURCE REPOSITORY</span>
              </div>
              <div class="repo-card-head">
                {presentation.avatar && (
                  <img
                    class="repo-avatar"
                    src={presentation.avatar.src}
                    alt={presentation.avatar.alt}
                    width="52"
                    height="52"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <h2>{presentation.repo.label}</h2>
              </div>
              <p>{presentation.repo.description}</p>
              <a
                class="btn-primary repo-card-cta"
                href={presentation.repo.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Browse code &amp; ISA docs on GitHub</span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          )
        }

        <div class="sources">
          <div class="eyebrow">
            <span class="pip" aria-hidden="true"></span>
            <span>FOLLOW THE EVIDENCE</span>
          </div>
          <h2>Sources &amp; analysis</h2>
          <p>
            Links are supplied by the author. Review their scope and revision; a link alone does not
            establish a claim.
          </p>
          <ol>
            {
              links.map((link) => (
                <li>
                  <a href={link} rel="ugc nofollow noopener noreferrer" target="_blank">
                    {new URL(link).hostname}
                    <span>{new URL(link).pathname} ↗</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>

        {
          renderedSections.length > 1 && (
            <nav class="jump-card" aria-label="Distillation sections">
              <div class="eyebrow">
                <span class="pip pip-amber" aria-hidden="true"></span>
                <span>SECTION INDEX</span>
              </div>
              <h2>On this page</h2>
              <ol class="jump-list">
                {renderedSections.map(([key, label], idx) => (
                  <li>
                    <a href={`#${key}`} class:list={[{ "is-boundary": key === "unknown" }]}>
                      <span>
                        {String(idx + 1).padStart(2, "0")}. {label}
                      </span>
                      <span aria-hidden="true">↓</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </aside>
    </div>

    {
      presentation && (
        <section class="related-research">
          <div class="eyebrow">
            <span class="pip" aria-hidden="true"></span>
            <span>CROSS-REFERENCE</span>
          </div>
          <h2>Related investigations</h2>
          <ul class="related-grid">
            {presentation.related
              .filter((slug) => researchPresentation[slug])
              .map((slug) => (
                <li>
                  <a href={"/entries/" + slug}>
                    <span>{researchPresentation[slug].title}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
          </ul>
        </section>
      )
    }
  </article>
</Layout>
