---
import Layout from "../layouts/Layout.astro";
import { publishedEntries, canonicalOrigin } from "../lib/catalog";

const all = await publishedEntries();
const q = (Astro.url.searchParams.get("q") || "").slice(0, 200);
const kind = Astro.url.searchParams.get("type") || "";

const entries = all.filter(
  (e) =>
    (!kind || e.data.kind === kind) &&
    (!q ||
      [e.data.title, e.data.target, e.data.summary, e.data.question]
        .join(" ")
        .toLowerCase()
        .includes(q.toLowerCase())),
);

const origin = canonicalOrigin();
const structured = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Reverse engineering research catalog",
  url: origin,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: entries.map((e, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: origin + "/entries/" + e.id,
      name: e.data.title,
    })),
  },
};

const targetTypes = [
  "Web application",
  "Native application",
  "Library / protocol",
  "Other",
];
---

<Layout noindex={!!q || !!kind} structured={structured}>
  <div class="dither-strip" data-dither-surface data-dither-density="0.22" aria-hidden="true"></div>

  <section class="hero">
    <div>
      <div class="eyebrow eyebrow-pill">
        <span class="pip" aria-hidden="true"></span>
        <span>AN OPEN INDEX OF HOW THINGS WORK</span>
      </div>

      <h1>
        Software reverse engineering<br />
        research.<br />
        <em>Evidence included.</em>
      </h1>

      <p class="lede">
        Explore the architecture, APIs, and decisions behind real systems. Read what was observed,
        what was inferred, and what remains unknown.
      </p>

      <div class="hero-actions">
        <a class="btn-primary" href="#catalog">
          <span>Explore the catalog</span>
          <span class="arrow" aria-hidden="true">↓</span>
        </a>
        <span class="hero-stat">
          <span class="pip pip-amber" aria-hidden="true"></span>
          <span>{all.length.toString().padStart(2, "0")} published distillations</span>
        </span>
      </div>
    </div>

    <div class="specimen-plate-wrap">
      <div class="corner-pin corner-pin-tl" aria-hidden="true"></div>
      <div class="corner-pin corner-pin-br" aria-hidden="true"></div>

      <aside class="diagram" aria-label="From system to evidence to understanding">
        <div class="diagram-dither-bg" data-dither-surface data-dither-density="0.18" aria-hidden="true"></div>

        <div class="diagram-top">
          <strong>METHODOLOGY</strong>
          <span>EMPIRICAL FLOW</span>
        </div>

        <div class="specimen-ruler" aria-hidden="true"></div>

        <div class="diagram-node">
          <div class="diagram-node-head">
            <span>SYSTEM</span>
            <span class="diagram-node-tag">TARGET</span>
          </div>
          <span class="diagram-node-sub">the thing we're investigating</span>
        </div>

        <div class="trace-connector" aria-hidden="true">
          <svg viewBox="0 0 24 26" fill="none">
            <line class="trace-line-base" x1="12" y1="1" x2="12" y2="21" />
            <line class="trace-line-pulse" x1="12" y1="1" x2="12" y2="21" />
            <path class="trace-arrow" d="M8.5 18.5L12 24L15.5 18.5H8.5Z" />
          </svg>
        </div>

        <div class="diagram-node is-evidence">
          <div class="diagram-node-head">
            <span>EVIDENCE</span>
            <span class="diagram-node-tag">OBSERVED</span>
          </div>
          <span class="diagram-node-sub">observations · traces · sources</span>
        </div>

        <div class="trace-connector" aria-hidden="true">
          <svg viewBox="0 0 24 26" fill="none">
            <line class="trace-line-base" x1="12" y1="1" x2="12" y2="21" />
            <line class="trace-line-pulse" x1="12" y1="1" x2="12" y2="21" />
            <path class="trace-arrow" d="M8.5 18.5L12 24L15.5 18.5H8.5Z" />
          </svg>
        </div>

        <div class="diagram-node is-understanding">
          <div class="diagram-node-head">
            <span>UNDERSTANDING</span>
            <span class="diagram-node-tag">BOUNDED</span>
          </div>
          <span class="diagram-node-sub">with the unknowns left visible</span>
        </div>

        <div class="diagram-bottom">
          <span>No black boxes. No borrowed certainty.</span>
        </div>
      </aside>
    </div>
  </section>

  <section id="catalog" class="catalog">
    <div class="section-heading">
      <div>
        <div class="eyebrow">
          <span class="pip" aria-hidden="true"></span>
          <span>THE RESEARCH INDEX</span>
        </div>
        <h2>Explore reverse engineering examples</h2>
      </div>

      <span class="count-badge">
        <span class="pip pip-amber" aria-hidden="true"></span>
        <span data-published-ticker data-published-count={String(all.length)}>
          {all.length.toString().padStart(2, "0")} published
        </span>
      </span>
    </div>

    <form class="filters" method="get" action="/#catalog">
      <label class="search-label">
        <span class="sr-only">Search research</span>
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input
          type="search"
          name="q"
          value={q}
          placeholder="Search a project, question, or finding…"
          maxlength="200"
        />
      </label>

      <label class="filter-select-wrap">
        <span class="sr-only">Target type</span>
        <select name="type">
          <option value="">All target types</option>
          {targetTypes.map((t) => <option selected={kind === t}>{t}</option>)}
        </select>
      </label>

      <button class="filters-submit" type="submit">
        <span>Search</span>
        <span aria-hidden="true">↗</span>
      </button>
    </form>

    {
      (q || kind) && (
        <div class="active-filter-bar">
          <span>
            Showing {entries.length} of {all.length} published distillations
            {kind ? ` · Type: ${kind}` : ""}
            {q ? ` · Query: “${q}”` : ""}
          </span>
          <a href="/#catalog">Clear filters</a>
        </div>
      )
    }

    <div class="research-grid">
      {
        entries.map((e, i) => (
          <a class="research-card" href={"/entries/" + e.id} data-content-source="emdash">
            <span class:list={["card-pip", { "is-amber": i % 2 === 0 }]} aria-hidden="true" />
            <div>
              <div class="card-top">
                <span class="tag">{e.data.kind}</span>
                <span class="card-number">{String(i + 1).padStart(2, "0")} ↗</span>
              </div>
              <div class="target">{e.data.target}</div>
              <h3>{e.data.title}</h3>
              <p>{e.data.summary}</p>
            </div>
            <div class="card-footer">
              <span>{e.data.author}</span>
              <span>{e.data.investigated_at}</span>
            </div>
          </a>
        ))
      }
    </div>

    {
      !entries.length && (
        <div class="empty">
          <h3>No matching distillations yet.</h3>
          <p>Try a broader search, or contribute the first investigation.</p>
          <a class="btn-primary" href="/">
            <span>Clear filters</span>
          </a>
        </div>
      )
    }
  </section>

  <section class="contribute">
    <div class="eyebrow">
      <span class="pip pip-amber" aria-hidden="true"></span>
      <span>LEAVE A TRAIL FOR THE NEXT PERSON</span>
    </div>
    <h2>Investigated something interesting?</h2>
    <p>
      Share the question, the findings, and the evidence. Every submission is reviewed before it
      joins the catalog.
    </p>
    <a class="btn-invert" href="/submit">
      <span>Contribute a distillation</span>
      <span aria-hidden="true">↗</span>
    </a>
  </section>
</Layout>
