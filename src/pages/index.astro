---
import Layout from '../layouts/Layout.astro';
import { publishedEntries,canonicalOrigin } from '../lib/catalog';
const all=await publishedEntries();const q=(Astro.url.searchParams.get('q')||'').slice(0,200);const kind=Astro.url.searchParams.get('type')||'';
const entries=all.filter(e=>(!kind||e.data.kind===kind)&&(!q||[e.data.title,e.data.target,e.data.summary,e.data.question].join(' ').toLowerCase().includes(q.toLowerCase())));
const origin=canonicalOrigin();
const structured={'@context':'https://schema.org','@type':'CollectionPage',name:'Reverse engineering research catalog',url:origin,mainEntity:{'@type':'ItemList',itemListElement:entries.map((e,i)=>({'@type':'ListItem',position:i+1,url:origin+'/entries/'+e.id,name:e.data.title}))}};
---
<Layout noindex={!!q||!!kind} structured={structured}><section class="hero"><div><div class="eyebrow"><span class="dot"></span> AN OPEN INDEX OF HOW THINGS WORK</div><h1>Software reverse engineering<br/>research.<br/><em>Evidence included.</em></h1><p class="lede">Explore the architecture, APIs, and decisions behind real systems. Read what was observed, what was inferred, and what remains unknown.</p><a class="text-link" href="#catalog">Explore the catalog <span>↓</span></a></div><aside class="diagram" aria-label="From system to evidence to understanding"><div class="diagram-top"><span>FIELD NOTES / 001</span><span>↗</span></div><div class="node">SYSTEM<span>the thing we're investigating</span></div><div class="connector">↓</div><div class="node evidence">EVIDENCE<span>observations · traces · sources</span></div><div class="connector">↓</div><div class="node result">UNDERSTANDING<span>with the unknowns left visible</span></div><div class="diagram-bottom">No black boxes. No borrowed certainty.</div></aside></section><section id="catalog" class="catalog"><div class="section-heading"><div><div class="eyebrow">THE RESEARCH INDEX</div><h2>Explore reverse engineering examples</h2></div><span class="count">{all.length.toString().padStart(2,'0')} published</span></div><form class="filters" method="get" action="/#catalog"><label class="search-label"><span class="sr-only">Search research</span><span aria-hidden="true">⌕</span><input type="search" name="q" value={q} placeholder="Search a project, question, or finding…" maxlength="200"/></label><label><span class="sr-only">Target type</span><select name="type"><option value="">All target types</option>{['Web application','Native application','Library / protocol','Other'].map(t=><option selected={kind===t}>{t}</option>)}</select></label><button type="submit">Search ↗</button></form><div class="research-grid">{entries.map((e,i)=><a class="research-card" href={'/entries/'+e.id} data-content-source="emdash"><div class="card-top"><span class="tag">{e.data.kind}</span><span class="card-number">{String(i+1).padStart(2,'0')} ↗</span></div><div class="target">{e.data.target}</div><h3>{e.data.title}</h3><p>{e.data.summary}</p><div class="card-footer"><span>{e.data.author}</span><span>{e.data.investigated_at}</span></div></a>)}</div>{!entries.length&&<div class="empty"><h3>No matching distillations yet.</h3><p>Try a broader search, or contribute the first investigation.</p><a href="/">Clear filters</a></div>}</section><section class="contribute"><span class="eyebrow">LEAVE A TRAIL FOR THE NEXT PERSON</span><h2>Investigated something interesting?</h2><p>Share the question, the findings, and the evidence. Every submission is reviewed before it joins the catalog.</p><a class="button" href="/submit">Contribute a distillation ↗</a></section></Layout>
