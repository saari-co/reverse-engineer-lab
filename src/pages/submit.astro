---
import Layout from "../layouts/Layout.astro";

const requiredFields: Array<[string, string, number]> = [
  ["title", "Research title", 140],
  ["target", "Target / project", 100],
  ["target_version", "Version or revision investigated", 120],
  ["author", "Your name or public handle", 100],
];

const areaFields: Array<[string, string, number, boolean]> = [
  ["question", "What did you investigate?", 1500, true],
  ["summary", "Findings summary", 5000, true],
  ["observed", "What did you observe?", 4000, true],
  ["inferred", "What did you infer?", 4000, false],
  ["unknown", "Coverage, limitations & unknowns", 4000, true],
  ["links", "Public evidence & analysis links", 6000, true],
];

const detailFields: Array<[string, string]> = [
  ["architecture", "Architecture"],
  ["models", "Domain & data models"],
  ["workflows", "Workflows & state machines"],
  ["apis", "API & protocol surfaces"],
];
---

<Layout title="Submit reverse engineering research | Reverse Engineer Lab" noindex>
  <section class="form-intro">
    <div>
      <div class="eyebrow">
        <span class="pip" aria-hidden="true"></span>
        <span>CONTRIBUTE TO THE INDEX</span>
      </div>
      <h1>
        Share what you<br />
        <em>figured out.</em>
      </h1>
      <p class="lede">
        A good distillation makes its evidence and its limits easy to see. Text and public links
        only. An editor reviews every submission before publication.
      </p>
    </div>

    <aside class="criteria-box" aria-label="Submission criteria">
      <div class="eyebrow">
        <span class="pip pip-amber" aria-hidden="true"></span>
        <span>SUBMISSION CRITERIA</span>
      </div>
      <ul>
        <li>Separate observed facts from architectural inferences</li>
        <li>State coverage limits and unprobed unknowns explicitly</li>
        <li>Pin public HTTPS links to an exact commit, release, or version</li>
      </ul>
    </aside>
  </section>

  <form id="submission" class="submission">
    <div class="form-drawer">
      <div class="drawer-header">
        <span class="eyebrow">
          <span class="pip" aria-hidden="true"></span>
          <span>01 / THE INVESTIGATION</span>
        </span>
      </div>

      <div class="form-grid">
        {
          requiredFields.map(([name, label, max]) => (
            <label class="field">
              <span class="field-head">
                <span>{label}</span>
                <span class="field-req">Required</span>
              </span>
              <input name={name} maxlength={max} required />
            </label>
          ))
        }

        <label class="field">
          <span class="field-head">
            <span>Target type</span>
            <span class="field-req">Required</span>
          </span>
          <select name="kind" required>
            {
              ["Web application", "Native application", "Library / protocol", "Other"].map((t) => (
                <option>{t}</option>
              ))
            }
          </select>
        </label>

        <label class="field">
          <span class="field-head">
            <span>Investigation date</span>
            <span class="field-req">Required</span>
          </span>
          <input
            name="investigated_at"
            type="date"
            max={new Date().toISOString().slice(0, 10)}
            required
          />
        </label>
      </div>
    </div>

    <div class="form-drawer">
      <div class="drawer-header">
        <span class="eyebrow">
          <span class="pip" aria-hidden="true"></span>
          <span>02 / FINDINGS &amp; EVIDENCE</span>
        </span>
      </div>

      <div class="field-stack">
        {
          areaFields.map(([name, label, max, isReq]) => {
            const isUnknown = name === "unknown";
            return (
              <div class:list={[{ "field-boundary": isUnknown }]}>
                <label class="field">
                  <span class="field-head">
                    <span>{label}</span>
                    <span class="field-req">{isReq ? "Required" : "Optional"}</span>
                  </span>
                  <textarea
                    name={name}
                    maxlength={max}
                    rows={name === "links" ? 3 : 4}
                    required={isReq}
                    placeholder={
                      name === "links"
                        ? "One public HTTPS URL per line, up to 8. Prefer links pinned to a revision."
                        : undefined
                    }
                  />
                </label>
              </div>
            );
          })
        }
      </div>
    </div>

    <details class="form-drawer">
      <summary>
        <span>03 / Add technical detail</span>
        <span class="field-req">Optional +</span>
      </summary>

      <div class="field-stack">
        {
          detailFields.map(([name, label]) => (
            <label class="field">
              <span class="field-head">
                <span>{label}</span>
                <span class="field-req">Optional</span>
              </span>
              <textarea name={name} maxlength="5000" rows="4" />
            </label>
          ))
        }
      </div>
    </details>

    <div class="trap" aria-hidden="true">
      <label>
        Website
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="consent-drawer">
      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>
          I have the right to share this text and these public links. I have excluded secrets,
          private research, and personal data. I understand that approved submissions are public.
        </span>
      </label>

      <p id="form-result" role="status" aria-live="polite"></p>

      <div class="submit-bar">
        <button class="btn-primary" type="submit">
          <span>Send for review</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </button>
        <p class="muted-note">Submissions are unpublished until approved. No files are accepted.</p>
      </div>
    </div>
  </form>

  <script>
    const form = document.querySelector<HTMLFormElement>("#submission")!;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const result = document.querySelector<HTMLElement>("#form-result")!;
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      button.disabled = true;
      result.textContent = "Saving your submission…";
      form.querySelectorAll("[aria-invalid]").forEach((e) => e.removeAttribute("aria-invalid"));
      try {
        const rawEntries = Object.fromEntries(new FormData(form));
        const payload: Record<string, FormDataEntryValue | boolean> = {
          ...rawEntries,
          consent: rawEntries.consent === "on",
        };
        const response = await fetch("/_emdash/api/plugins/rea-catalog/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const envelope = (await response.json()) as {
          data?: {
            ok?: boolean;
            error?: string;
            reference?: string;
            fields?: Record<string, string[] | string>;
          };
        };
        const body = envelope.data;
        if (!response.ok || !body?.ok) {
          for (const key of Object.keys(body?.fields || {})) {
            const item = form.elements.namedItem(key);
            if (item instanceof HTMLElement) {
              item.setAttribute("aria-invalid", "true");
            }
          }
          result.textContent = body?.error || "Could not save. Please try again.";
          if (body?.fields) {
            result.textContent += " " + Object.values(body.fields).flat().join(" ");
          }
        } else {
          form.reset();
          result.textContent = `Received. Your submission is pending editorial review. Reference: ${body.reference}`;
        }
      } catch {
        result.textContent = "Connection interrupted. Please try again.";
      } finally {
        button.disabled = false;
      }
    });
  </script>
</Layout>
