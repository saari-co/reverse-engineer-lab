---
import Layout from '../layouts/Layout.astro';
const required=[['title','Research title',140],['target','Target / project',100],['target_version','Version or revision investigated',120],['author','Your name or public handle',100]];
const areas=[['question','What did you investigate?',1500,true],['summary','Findings summary',5000,true],['observed','What did you observe?',4000,true],['inferred','What did you infer?',4000,false],['unknown','Coverage, limitations & unknowns',4000,true],['links','Public evidence & analysis links',6000,true]];
---
<Layout title="Submit reverse engineering research | Reverse Engineer Lab" noindex><section class="form-intro"><div class="eyebrow">CONTRIBUTE TO THE INDEX</div><h1>Share what you<br/><em>figured out.</em></h1><p class="lede">A good distillation makes its evidence and its limits easy to see. Text and public links only. An editor reviews every submission before publication.</p></section><form id="submission" class="submission"><div class="form-section"><span class="eyebrow">01 / THE INVESTIGATION</span><div class="form-grid">{required.map(([name,label,max])=><label>{label}<span>Required</span><input name={name} maxlength={max} required/></label>)}<label>Target type<span>Required</span><select name="kind" required>{['Web application','Native application','Library / protocol','Other'].map(t=><option>{t}</option>)}</select></label><label>Investigation date<span>Required</span><input name="investigated_at" type="date" max={new Date().toISOString().slice(0,10)} required/></label></div></div><div class="form-section"><span class="eyebrow">02 / FINDINGS & EVIDENCE</span>{areas.map(([name,label,max,required])=><label>{label}<span>{required?'Required':'Optional'}</span><textarea name={name} maxlength={max} rows={name==='links'?3:4} required={required} placeholder={name==='links'?'One public HTTPS URL per line, up to 8. Prefer links pinned to a revision.':undefined}/></label>)}</div><details class="form-section"><summary>03 / Add technical detail <span>Optional +</span></summary>{[['architecture','Architecture'],['models','Domain & data models'],['workflows','Workflows & state machines'],['apis','API & protocol surfaces']].map(([name,label])=><label>{label}<textarea name={name} maxlength="5000" rows="4"/></label>)}</details><div class="trap" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"/></label></div><label class="consent"><input type="checkbox" name="consent" required/><span>I have the right to share this text and these public links. I have excluded secrets, private research, and personal data. I understand that approved submissions are public.</span></label><p id="form-result" role="status" aria-live="polite"></p><button class="button" type="submit">Send for review ↗</button><p class="muted">Submissions are unpublished until approved. No files are accepted.</p></form><script>
const form=document.querySelector<HTMLFormElement>('#submission')!;
form.addEventListener('submit',async(event)=>{event.preventDefault();const result=document.querySelector('#form-result')!;const button=form.querySelector<HTMLButtonElement>('button[type=submit]')!;button.disabled=true;result.textContent='Saving your submission…';form.querySelectorAll('[aria-invalid]').forEach(e=>e.removeAttribute('aria-invalid'));try{const data=Object.fromEntries(new FormData(form));data.consent=data.consent==='on' as any;const response=await fetch('/_emdash/api/plugins/rea-catalog/submit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const envelope=await response.json();const body=envelope.data;if(!response.ok||!body?.ok){for(const key of Object.keys(body?.fields||{})){form.elements.namedItem(key)?.setAttribute?.('aria-invalid','true');}result.textContent=body?.error||'Could not save. Please try again.';if(body?.fields)result.textContent+=' '+Object.values(body.fields).flat().join(' ');}else{form.reset();result.textContent=`Received. Your submission is pending editorial review. Reference: ${body.reference}`;}}catch{result.textContent='Connection interrupted. Please try again.';}finally{button.disabled=false;}});
</script></Layout>
