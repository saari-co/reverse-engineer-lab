{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reverse-engineer-lab",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CATALOG_ORIGIN": "https://reverseengineerlab.com",
    "EMDASH_SITE_URL": "https://reverseengineerlab.com",
    "CF_ACCESS_AUDIENCE": "b55412d5c7635c7416f322b6f8cd299d0552ba4ef9fa7d7f55ac3b8497365a7d"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reverse-engineer-lab-cms",
      "database_id": "5445fd14-19ba-459f-8a42-45b975414155"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "reverse-engineer-lab-media"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "routes": [
    {
      "pattern": "reverseengineerlab.com",
      "custom_domain": true
    },
    {
      "pattern": "www.reverseengineerlab.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "53ebb9197ef646d6a1ac6b3954788bb8"
    }
  ]
}
